/.idea
/practice
/autobus-docs/site
/.claude
__pycache__/
.ipynb_checkpoints/

# Experiment runs: large, regenerable, and deliberately not backed up.
# Decision 2026-08-11 -- the volume produced makes tracking them impractical.
# How storage is handled may be revisited; the notebooks are the record.
/results/runs/

# Runs retired from the store because the code that produced them changed.
# Kept out of the store so `load_runs` cannot pool them with current results,
# and out of git for the same reason `/results/runs/` is.
/results/archive/

# compose.yml is shipped: it builds docker/carla/Dockerfile, which needs
# nothing from the host but the kernel and /dev/dri, so one image serves
# every machine. Anything named compose_<something>.yml is by convention a
# host-specific variant -- a driver bind-mount, a software-Vulkan fallback --
# and stays local to the machine that needs it.
/compose_*.yml
